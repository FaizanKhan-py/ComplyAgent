# Copy to backend/.env and fill in. Never commit the real .env.

# development | production. In production the server refuses to start without ADMIN_API_TOKEN.
APP_ENV=development

# Bearer token required on every /api/admin/* request. Leave empty only for local development.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite knowledge base, uploaded files and the embedding model cache live.
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# Chunking (characters).
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Embeddings: "fastembed" (local semantic model, downloaded once, no API key)
# or "hashing" (offline keyword-style fallback, lower quality).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval. Leave RAG_MIN_SCORE empty to use the embedding provider's default (0.6 for fastembed).
RAG_TOP_K=5
RAG_MIN_SCORE=

# Answer generation: "auto" uses Claude when ANTHROPIC_API_KEY is set, otherwise answers are
# retrieval-only (passages shown, no generated text). "anthropic" forces Claude; "none" disables it.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60
