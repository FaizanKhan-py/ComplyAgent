# Copy to backend/.env and fill in. Never commit the real .env.

# development | production. Production always marks the session cookie Secure (HTTPS only).
APP_ENV=development

# --- Accounts and sessions -------------------------------------------------------------------
# People sign in with an email and password; there is nothing secret to configure for that.
# Create the first administrator from the server, never through sign-up:
#   python -m app.manage create-admin --email you@example.com --name "Your Name"

# false closes the public sign-up page (accounts are then created with app.manage only).
ALLOW_REGISTRATION=true
# How long a sign-in lasts.
SESSION_TTL_HOURS=12
# Send the session cookie over HTTPS only. Empty: on in production, off in development.
COOKIE_SECURE=
# Failed sign-ins allowed per email and client inside the window, before a temporary lock-out.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Sign-ups allowed per client per hour.
REGISTER_MAX_PER_HOUR=10

# Optional credential for scripts: "Authorization: Bearer <token>" gets administrator access
# without a session. Leave empty to turn it off. At least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Comma-separated browser origins allowed to call the API (and to send the session cookie).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite knowledge base, uploaded files and the embedding model cache live.
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# Chunking (characters).
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Embeddings: "fastembed" (local semantic model, downloaded once, no API key)
# or "hashing" (offline keyword-style fallback, lower quality).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval. Leave RAG_MIN_SCORE empty to use the embedding provider's default (0.6 for fastembed).
RAG_TOP_K=5
RAG_MIN_SCORE=

# Answer generation:
#   auto       Claude when ANTHROPIC_API_KEY is set, otherwise retrieval-only (passages, no text)
#   anthropic  always Claude
#   ollama     a local model served by Ollama (no API key, no cost)
#   none       never generate
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Used when LLM_PROVIDER=ollama. The model must be pulled first: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window in tokens. Empty uses Ollama's default (4096), which fits the default
# retrieval settings. Raise it only if you raise RAG_TOP_K a lot; larger is slower.
OLLAMA_NUM_CTX=
LLM_TIMEOUT_SECONDS=60
